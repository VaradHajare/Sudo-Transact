# Copy to backend/.env and fill in keys. Never commit backend/.env.

# --- app / session
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
SESSION_TOKEN_SECRET=change-me
SESSION_TOKEN_TTL_SECONDS=86400
PUBLIC_BASE_URL=http://localhost:8000
DEMO_MODE=true
SEED_DEMO_DATA=true
DEMO_USER_ID=u_demo

# --- database (SQLite only; relative paths resolve against backend/)
DATABASE_URL=sqlite:///data/sudo_transact.db
SQLITE_BUSY_TIMEOUT_MS=5000

# --- LLM (OpenAI-compatible; off = templates only)
LLM_ENABLED=false
LLM_BASE_URL=
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_JSON_MODE=false
LLM_TIMEOUT_SECONDS=10
LLM_MAX_TOKENS=2000
LLM_MIN_CONFIDENCE=0.7
LLM_INTENT_ENABLED=true
LLM_CLASSIFY_ENABLED=true
LLM_CASE_SUMMARY_ENABLED=true
LLM_REPHRASE_ENABLED=false

# --- Sarvam STT / TTS (off = text only)
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
STT_ENABLED=false
TTS_ENABLED=false
STT_MAX_AUDIO_BYTES=10485760
MEDIA_DIR=media

# --- decision rules (spec 8.2; verify SLA values against the current RBI circular)
COMPENSATION_PER_DAY=100
SLA_BENEFICIARY_CREDIT_FAILURE_DAYS=1
SLA_MERCHANT_CONFIRMATION_MISSING_DAYS=5
PENDING_WINDOW_MINUTES=30
RETRY_COOLDOWN_SECONDS=600
MAX_RETRIES_PER_TXN=1
EVIDENCE_LAG_SECONDS=120
RECHECK_INTERVAL_MINUTES=15
REPEAT_CLAIM_THRESHOLD=3
REPEAT_CLAIM_WINDOW_DAYS=30

# --- background scheduler (jobs table polled by one in-process worker)
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=2
JOB_MAX_ATTEMPTS=3
JOB_RETRY_DELAY_SECONDS=60
DISPUTE_FOLLOWUP_HOURS=24
